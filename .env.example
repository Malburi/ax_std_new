# 시스템 wiki를 MSSQL DB에 저장하려면(generate-wiki --storage db, v1 단일 테이블), 대상 프로젝트 루트에
# 이 파일을 .env로 복사하고 실제 접속 정보로 채운다. .env는 git에 커밋하지 않는다(.gitignore).
MSSQL_HOST=
MSSQL_PORT=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DATABASE=

# ---- 아래는 별도 프로젝트 wiki-hub(publish-wiki / wiki-hub 스킬)가 읽는 설정 ----
# wiki-hub는 harness 플러그인과 무관하게 별도로 설치·실행되는 중앙 허브다.
# 대상 프로젝트 루트에 이 파일을 .env로 복사해 채우면 wiki-hub-publish/wiki-hub-serve 양쪽이 그대로 쓴다.

# ---- DB 엔진 선택 ----
# mssql | postgresql | oracle | sqlite
# 미지정 시 sqlite로 동작한다 (안전한 기본값 — 별도 서버 없이 파일 하나로 시험 가능).
WIKI_DB_ENGINE=mssql

# ---- SQLite (1인 사용·오프라인·시험용) ----
# 여러 harness 프로젝트에서 발행할 계획이면, 모든 프로젝트가 "같은 파일 경로"를
# 가리켜야 한다. 프로젝트마다 다른 경로를 쓰면 허브에 시스템이 하나씩만 보인다.
WIKI_SQLITE_PATH=

# ---- MSSQL (드라이버: pip install pymssql) ----
# WIKI_DB_ENGINE=mssql이면 위 MSSQL_* 필드를 그대로 재사용한다 (v1과 같은 서버를 공유해도 무방).
MSSQL_PORT=1433

# ---- PostgreSQL (드라이버: pip install psycopg2-binary) ----
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# ---- Oracle (드라이버: pip install oracledb, Instant Client 불필요) ----
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE=
ORACLE_USER=
ORACLE_PASSWORD=

# ---- 고급: 위 항목 대신 SQLAlchemy URL을 직접 줄 수도 있다 ----
# 지정하면 WIKI_DB_ENGINE과 무관하게 이 값을 그대로 쓴다.
# 예) postgresql+psycopg2://user:pass@host:5432/db
WIKI_DB_URL=

# ---- 이 저장소가 중앙 DB에서 갖는 좌표 ----
# WIKI_SYSTEM_KEY    : 업무 시스템 단위. 백엔드/프론트엔드 저장소가 한 시스템이면 같은 값을 쓴다.
#                      (v1 단일 테이블 저장에서도 같은 이름의 변수를 쓴다 — 의미가 같아 재사용)
# WIKI_SYSTEM_NAME   : 허브 목록에 보일 표시 이름.
# WIKI_COMPONENT_KEY : 시스템 안에서의 구분자. 같은 레이어가 둘 이상이면 admin-web 처럼 따로 준다.
# WIKI_COMPONENT_TYPE: backend | frontend | fullstack | batch | mobile | common
WIKI_SYSTEM_KEY=
WIKI_SYSTEM_NAME=
WIKI_COMPONENT_KEY=
WIKI_COMPONENT_TYPE=
